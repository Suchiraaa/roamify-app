# Roamify Backend Environment Variables

# Google Gemini API Key (Obtain from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional Gemini Model override (default: gemini-3.5-flash)
# GEMINI_MODEL=gemini-3.5-flash

# OpenWeatherMap API Key (Obtain from: https://openweathermap.org/api)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# OpenRouteService API Key (Sign up for free at https://openrouteservice.org/dev/#/signup)
# Optional: If omitted or empty, Roamify uses public OSM / OSRM and synthetic routing as fallback.
ORS_API_KEY=your_ors_api_key_here

# Backend server host and port
PORT=8000
HOST=0.0.0.0

# Database Configuration (SQLite)
# 1. Local Development (Default local SQLite file):
DATABASE_URL=sqlite:///./roamify.db

# 2. Production with Turso (Cloud-Hosted SQLite for persistent free storage on Render):
# Sign up at https://turso.tech/ -> create free database -> copy URL and auth token
# TURSO_DATABASE_URL=libsql://your-db-name-your-user.turso.io
# TURSO_AUTH_TOKEN=your_turso_auth_token_here

# 3. Alternatively, pass Turso URL directly in DATABASE_URL:
# DATABASE_URL=libsql://your-db-name-your-user.turso.io?authToken=your_turso_auth_token_here

# Authentication & Session Security
# Generate secure random strings: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_secure_random_secret_in_production
CSRF_SECRET_KEY=change_this_to_a_secure_csrf_secret_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Cookie Configuration
# Same-Domain (Reverse Proxy via Vercel): COOKIE_SAMESITE=Lax, COOKIE_SECURE=False (or True in HTTPS)
COOKIE_SAMESITE=Lax
COOKIE_SECURE=False

# Allowed CORS Origins (Comma-separated list, NO wildcards with credentials)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://roamify-app-six.vercel.app
